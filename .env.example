# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://disgen:changeme@postgres:5432/disgen
DATABASE_TEST_URL=postgresql://disgen:changeme@postgres:5432/disgen_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=disgen_admin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=disgen-documents

# ── Azure Document Intelligence (OCR — Central India, Pune — DPDP compliant)
# Create resource at portal.azure.com → Document Intelligence → Region: Central India
AZURE_DOCUMENT_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCUMENT_KEY=changeme

# ── LLM provider ──────────────────────────────────────────────────────────────
# Pluggable (backend/llm/provider.py). "openai" processes patient PHI in the US
# and is NOT DPDP-compliant — startup logs a loud warning and /health reports
# dpdp_compliant=false. Switch to an in-India provider before hospital go-live.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL_ID=gpt-4o
# Per-chunk source-token budget for long-document extraction. Lower = safer
# against the 16K output cap on 10–20 page K-shapes; higher = fewer LLM calls.
EXTRACTION_CHUNK_TOKEN_BUDGET=6000

# ── Encryption ────────────────────────────────────────────────────────────────
# Must be exactly 32 bytes, base64url encoded. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=changeme-must-be-32-bytes-base64url=

# ── Auth JWT ──────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/app/auth/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/auth/keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://localhost,https://disgen.local

# ── Hospital ──────────────────────────────────────────────────────────────────
HOSPITAL_NAME=Your Hospital Name
HOSPITAL_ID=hospital-001

# ── GlitchTip ────────────────────────────────────────────────────────────────
GLITCHTIP_SECRET_KEY=changeme
GLITCHTIP_DSN=
GLITCHTIP_DOMAIN=http://localhost
GLITCHTIP_EMAIL_URL=consolemail://

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/2

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme

# ── API Docs ──────────────────────────────────────────────────────────────────
# Disabled by default — NEVER enable in production.
# For staging/dev only: set a strong password (not "changeme") before enabling.
DOCS_ENABLED=false
DOCS_USERNAME=disgen-dev
DOCS_PASSWORD=changeme-docs

# ── DPDP / Compliance ─────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=2555
ANONYMIZE_ON_EXPIRY=true
